# =========================
# Railway / Producción
# =========================
ENVIRONMENT=production

# Railway PostgreSQL inyecta DATABASE_URL al conectar la BD.
# No uses SQLite en producción.
DATABASE_URL=${{Postgres.DATABASE_URL}}

SECRET_KEY=reemplaza_por_una_clave_larga_real_de_32_o_mas_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cambia esta URL por la URL real del frontend en Railway.
ALLOWED_ORIGINS=https://TU_FRONTEND.up.railway.app
FRONTEND_URL=https://TU_FRONTEND.up.railway.app

# Admin inicial. Usa una clave fuerte.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=ClaveSeguraProduccion123

# Branding inicial
EMPRESA_NOMBRE=Practicas
EMPRESA_LOGO_URL=
EMPRESA_COLOR_PRIMARY=#1a56db
EMPRESA_COLOR_SECONDARY=#0e3a8c

# Correo
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
CORREO_EMISOR=
CORREO_CONTRASENA=
CORREO_RECEPTOR=

# WhatsApp
URL_API_WHATSAPP=https://api.callmebot.com/whatsapp.php
TOKEN_WHATSAPP=
TELEFONO_DESTINO_WA=

# SECOP
UMBRAL_SIMILITUD=0.50
URLS_SECOP=https://www.datos.gov.co/resource/p6dx-8zbt.json?$limit=2000&$order=:id DESC,https://www.datos.gov.co/resource/jbjy-vk9h.json?$limit=2000&$order=:id DESC
SECOP_APP_TOKEN=

# Hugging Face
HF_TOKEN=

# Seguridad
RATE_LIMIT_PER_MINUTE=60
